              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"value\": \"<string>\"\n}",
              "options": {
                "raw": {
                  "headerFamily": "json",
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/token",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "token"
              ]
            },
            "description": "Provide a one time token (e.g. obtained through the thirdparty callback) to retrieve a session JWT as cookie\nand/or via `X-Auth-Token` header."
