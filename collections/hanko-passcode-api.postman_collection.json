        {
          "id": "1096e972-6991-412a-b71d-cbb5033ed72b",
          "name": "Initialize passcode login",
          "request": {
            "name": "Initialize passcode login",
            "description": {
              "content": "Initialize a passcode login for the user identified by `user_id`. Sends an email\ncontaining the actual passcode to the user's primary email address or to the address specified\nthrough `email_id`. Returns a representation of the passcode.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "passcode",
                "login",
                "initialize"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "description": "The (UU)ID of a tenant. Replace the default value with your tenant ID.",
                  "type": "any",
                  "value": "{{tenant_id}}",
                  "key": "tenant_id"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_id\": \"<uuid4>\",\n  \"email_id\": \"<uuid4>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
