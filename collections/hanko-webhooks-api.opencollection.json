            "url": "https://{tenant_id}.hanko.io/admin/webhooks/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "UUID of the requested object"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Update a webhook by ID"
        },
        {
          "info": {
            "name": "Delete a webhook by ID",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://{tenant_id}.hanko.io/admin/webhooks/:id",
            "params": [
              {
                "name": "id",
                "value": "",
