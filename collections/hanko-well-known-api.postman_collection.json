          "name": "Get JSON Web Key Set",
          "request": {
            "name": "Get JSON Web Key Set",
            "description": {
              "content": "Retrieve a [JSON Web Key Set](https://www.rfc-editor.org/rfc/rfc7517#section-5) (JWKS) object containing the public `keys` used to verify\nJSON Web Tokens (JWT) issued by the Hanko API and signed using the RS256 signing algorithm.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                ".well-known",
                "jwks.json"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "description": "The (UU)ID of a tenant. Replace the default value with your tenant ID.",
                  "type": "any",
                  "value": "{{tenant_id}}",
                  "key": "tenant_id"
                }
              ]
            },
